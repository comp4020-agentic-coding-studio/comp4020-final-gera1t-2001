{
  // Covers the supplied harness (spec/, scripts/) plus the app itself (src/).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    // src/poker/render.js runs in the browser as well as on the server, so
    // it is plain JavaScript; this type-checks it from its JSDoc.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["*.ts", "spec", "scripts", "src"]
}
